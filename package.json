{
  "name": "whatsthisposition",
  "version": "1.0.1",
  "private": true,
  "description": "what’sthisposition: free, open-source chess game review and position analysis that explains every move.",
  "license": "GPL-3.0-or-later",
  "author": "Ayushman Chaudhuri (https://ayushman.rocks)",
  "homepage": "https://whatsthisposition.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acunli/whatsthisposition.git"
  },
  "bugs": {
    "url": "https://github.com/acunli/whatsthisposition/issues"
  },
  "keywords": [
    "chess",
    "stockfish",
    "game-review",
    "chess-analysis",
    "brilliant-moves",
    "opening-book",
    "nextjs",
    "webassembly"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "postinstall": "node scripts/copy-engine.mjs",
    "predev": "node scripts/copy-engine.mjs",
    "prebuild": "node scripts/copy-engine.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "vision:check": "node scripts/vision-check.mjs",
    "ext:build": "node extension/build.mjs",
    "ext:zip": "node extension/build.mjs --zip"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@react-three/fiber": "^9.8.1",
    "chess.js": "^1.4.0",
    "next": "^16.3.7",
    "openai": "^7.25.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "stockfish": "^19.0.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
