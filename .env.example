# Photo recognition (optional). Without a key, photo upload shows a clear
# "not configured" message and FEN / manual setup keep working.
#
# The key is read only on the server (src/app/api/recognize/route.ts) and is
# never sent to the browser.
VISION_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Optional: override the vision model (default: claude-opus-5-5).
# VISION_MODEL=claude-opus-5-5
