# ─────────────────────────────────────────────────────────────
# WhatsThisPosition · environment
# Copy to .env.local and fill in. .env.local is gitignored.
# Only photo recognition needs a key; FEN, PGN and hand setup work without one.
# Keys are read on the server only and never sent to the browser.
# ─────────────────────────────────────────────────────────────

# Which vision provider reads photos: "soclaas" or "anthropic".
# If unset, the first one with a key below is used.
VISION_PROVIDER=soclaas

# NUS SoCLaaS gateway (OpenAI-compatible, serves Qwen models).
SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
SOCLAAS_API_KEY=
# Must be a model that accepts images. Run `npm run vision:check` to list models.
SOCLAAS_MODEL=default

# Optional alternative: Anthropic.
# ANTHROPIC_API_KEY=
# VISION_MODEL=claude-opus-5-5

# Optional: lets "Lichess username" import list a player's games.
# Lichess only lists games to signed-in apps. Create a free personal token
# (no scopes needed) at https://lichess.org/account/oauth/token
# Game links and Chess.com usernames work without it.
LICHESS_TOKEN=
