# ─────────────────────────────────────────────────────────────
# what’sthisposition · environment
# Copy to .env.local (or set these in your host's dashboard). .env.local is gitignored.
#
# Nothing here is required. With no variables at all the site works fully:
# game review, analysis and the photo reader all run in the visitor's browser.
# Keys are read on the server only and are never sent to the browser.
# ─────────────────────────────────────────────────────────────

# Optional: the public address, used in page metadata, share previews and the
# sitemap. On Vercel it follows the project's production domain by itself; set it
# when hosting elsewhere on a domain other than whatsthisposition.com. Read at build time.
NEXT_PUBLIC_SITE_URL=

# Optional: behind a proxy other than Vercel or Caddy (e.g. Cloudflare), the header
# that carries the visitor's real IP, for the rate limits. Example: cf-connecting-ip
CLIENT_IP_HEADER=

# Optional: lets "Lichess username" import list a player's games.
# Lichess only lists games to signed-in apps. Create a free personal token
# (no scopes needed) at https://lichess.org/account/oauth/token
# Game links and Chess.com usernames work without it.
LICHESS_TOKEN=

# ── Optional cloud photo reader ──────────────────────────────
# Only for angled photos of real boards; screenshots are read on the device.
# Each photo is one paid API call, so leave these empty on a public site unless
# you mean to pay for it (the route is rate-limited to 6 photos/minute/visitor).
#
# Which provider reads photos: "anthropic" or "soclaas". If unset, the first one
# with a key below is used; with no key the cloud reader is simply off.
VISION_PROVIDER=

# Anthropic (Claude) vision.
ANTHROPIC_API_KEY=
# VISION_MODEL=claude-opus-5-5

# Any OpenAI-compatible endpoint that accepts images (the code was built against
# the NUS SoCLaaS gateway). Use a key you're allowed to use for public traffic.
SOCLAAS_BASE_URL=
SOCLAAS_API_KEY=
# Must be a model that accepts images. Run `npm run vision:check` to list models.
SOCLAAS_MODEL=default
